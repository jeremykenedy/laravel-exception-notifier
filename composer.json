{
    "name": "jeremykenedy/laravel-exception-notifier",
    "description": "Send Laravel exception emails with stack traces and configurable recipients.",
    "keywords": [
        "laravel",
        "exception",
        "notification",
        "email",
        "email-notifications",
        "email-notification",
        "laravel-exceptions",
        "exception-handler",
        "exception-email",
        "exception-emails",
        "exception-messages"
    ],
    "license": "MIT",
    "type": "package",
    "authors": [
        {
            "name": "jeremykenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "laravel/framework": "9.*|10.*|11.*|12.*|13.*",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\laravelexceptionnotifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\laravelexceptionnotifier\\Test\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\laravelexceptionnotifier\\LaravelExceptionNotifier"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint"
    }
}
